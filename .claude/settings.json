{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "model": "sonnet",
  "cleanupPeriodDays": 30,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch*)",
      "PowerShell(node scripts/token-report.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/appsettings.*.local.json)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(curl*)",
      "PowerShell(wget*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(iwr*)",
      "PowerShell(irm*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/scope-guard.mjs" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/command-guard.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs" }]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/worktree-create.mjs" }]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/worktree-remove.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/token-report.mjs --quiet" },
          { "type": "command", "command": "node .claude/hooks/run-tests.mjs" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/token-report.mjs --quiet" },
          { "type": "command", "command": "node .claude/hooks/run-tests.mjs" }
        ]
      }
    ]
  }
}
